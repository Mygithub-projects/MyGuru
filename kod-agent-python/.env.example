# Salin fail ini ke `.env` dan isi nilai sebenar. JANGAN commit `.env`.
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#
#   cp .env.example .env

# --- Claude / Anthropic ---------------------------------------------------
# Boleh dikosongkan jika anda guna `ant auth login` — SDK membaca profil
#   tersebut secara automatik. Kunci di sini mengatasi profil.
# May be left empty if you use `ant auth login` — the SDK reads that profile
#   automatically. A key here overrides the profile.
ANTHROPIC_API_KEY=""

# Lalai claude-opus-5. Guna claude-haiku-4-5 untuk kos lebih rendah pada
#   kerja mudah. Jangan tambah akhiran tarikh pada ID model.
# Defaults to claude-opus-5. Use claude-haiku-4-5 for lower cost on simple
#   work. Do not append date suffixes to model IDs.
AI_MODEL="claude-opus-5"

# low | medium | high | xhigh | max
# Kedalaman penaakulan & belanja token / Reasoning depth & token spend.
AI_EFFORT="high"

# --- Pangkalan data / Database --------------------------------------------
# AMARAN: `ekokot6/.env` menunjuk ke pangkalan data JAUH yang dikongsi.
#   Sahkan sasaran anda sebelum menjalankan apa-apa yang menulis.
# WARNING: `ekokot6/.env` points at a shared REMOTE database. Verify your
#   target before running anything that writes.
#
# Stack Docker tempatan (../DOCKER.md) menerbitkan Postgres pada port hos
#   5433 (5432 di dalam bekas). Tukar dengan DB_PORT jika perlu.
# The local Docker stack (../DOCKER.md) publishes Postgres on host port 5433
#   (5432 inside the container). Override with DB_PORT if needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ekokot6"

# --- Fail sumber / Source files -------------------------------------------
# Folder yang mengandungi namelist.xlsx / GURU DATA.xlsx / DUMM PAJSK.xlsx.
#   Relatif kepada folder ini: dua tingkat ke atas (keluar dari ekokot6).
# Folder holding namelist.xlsx / GURU DATA.xlsx / DUMM PAJSK.xlsx.
#   Relative to this folder: two levels up (outside ekokot6).
DATA_DIR="../../"

# --- Log -------------------------------------------------------------------
LOG_LEVEL="INFO"
